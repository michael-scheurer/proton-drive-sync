                                     shadow_type=Gtk.ShadowType.IN)
        lscroll.add(self.live_view)
        self.live_stack = self._list_or_empty(lscroll, "No activity yet")

        self.files_view = Gtk.Stack()
        self.files_view.add_named(self.files_stack, "queue")
        self.files_view.add_named(self.live_stack, "live")
        outer.pack_start(self.files_view, True, True, 0)
        self.live_btn.connect("toggled", self._on_files_view_toggled)
        # Start on the live view while a sync is running.
        status = read_status() or {}
        self.live_btn.set_active(status.get("state") in BUSY_STATES
                                 and daemon_running())

        self.history_heading = Heading("History", info=True, margin_top=10)
        outer.pack_start(self.history_heading, False, False, 0)
        chart_frame = Gtk.Frame()
        if HAVE_CAIRO:
            self.chart = PassChart()
            chart_frame.add(self.chart)
        else:
            self.chart = None
            hint = Gtk.Label(
                label="Install python3-gi-cairo to see the chart:\n"
                      "sudo apt install python3-gi-cairo",
                justify=Gtk.Justification.CENTER, margin=20)
            hint.get_style_context().add_class("dim-label")
            chart_frame.add(hint)
        outer.pack_start(chart_frame, False, False, 0)

        expander = Gtk.Expander(label="Technical log", margin_top=10)
        expander.set_resize_toplevel(True)
        lbox = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6,
                       margin_top=6)
        lscroll = Gtk.ScrolledWindow(min_content_height=180,
                                     shadow_type=Gtk.ShadowType.IN)
        self.log_view = Gtk.TextView(editable=False, cursor_visible=False,
                                     monospace=True)
        self.log_view.set_wrap_mode(Gtk.WrapMode.NONE)
        lscroll.add(self.log_view)
        lbox.pack_start(lscroll, True, True, 0)
        log_btn = Gtk.Button(label="Open full log", halign=Gtk.Align.START)
        log_btn.connect("clicked", self.on_open_log)
        lbox.pack_start(log_btn, False, False, 0)
        expander.add(lbox)
        outer.pack_start(expander, False, False, 0)
        return outer

    @staticmethod
    def _list_or_empty(scrolled, empty_text):
        stack = Gtk.Stack()
        stack.add_named(scrolled, "list")
        empty = Gtk.Label(label=empty_text, margin=24)
        empty.get_style_context().add_class("dim-label")
        stack.add_named(empty, "empty")
        return stack

    def _on_files_view_toggled(self, _btn):
        self.files_view.set_visible_child_name(
            "live" if self.live_btn.get_active() else "queue")

    # ---- excludes list helpers
    def _add_exclude_row(self, path):
        row = Gtk.ListBoxRow()
        row.path = path
        row.label = Gtk.Label(xalign=0, margin=6,
                              ellipsize=Pango.EllipsizeMode.MIDDLE)
        row.add(row.label)
        self.excl_list.add(row)
        self._set_exclude_label(row)
        self.excl_list.show_all()

    def _set_exclude_label(self, row):
        row.label.set_text(
            relative_name(row.path, self.folder_btn.get_filename() or ""))
        row.set_tooltip_text(row.path)

    def _refresh_exclude_labels(self):
        for row in self.excl_list.get_children():
            self._set_exclude_label(row)

    def current_excludes(self):
        return [row.path for row in self.excl_list.get_children()]

    def on_add_exclude(self, _btn):
        dlg = Gtk.FileChooserDialog(
            title="Folder to exclude from sync", parent=self,
            action=Gtk.FileChooserAction.SELECT_FOLDER,
        )
        dlg.add_buttons("Cancel", Gtk.ResponseType.CANCEL,
                        "Exclude", Gtk.ResponseType.OK)
        root = self.folder_btn.get_filename()
        if root:
            dlg.set_current_folder(root)
        if dlg.run() == Gtk.ResponseType.OK:
            path = dlg.get_filename()
            if path and path not in self.current_excludes():
                self._add_exclude_row(path)
        dlg.destroy()

    def on_remove_exclude(self, _btn):
        row = self.excl_list.get_selected_row()
        if row:
            self.excl_list.remove(row)

    # ---- actions
    def on_save(self, _btn):
        local_root = self.folder_btn.get_filename() or ""
        if not local_root:
            self.flash("Choose a folder to sync first.")
            return
        remote = self.remote_entry.get_text().strip()
        if not remote:
            remote = "/" + os.path.basename(local_root)
        if not remote.startswith("/"):
            remote = "/" + remote
        # Proton Drive namespaces user files under /my-files.
        if remote != "/my-files" and not remote.startswith("/my-files/"):
            remote = "/my-files" + remote
        self.cfg.update({
            "LOCAL_ROOT": local_root,
            "REMOTE_ROOT": remote,
            "POLL_INTERVAL": poll_minutes_to_config(
                self.poll_spin.get_value_as_int()),
            "FULL_CHECK_INTERVAL": hours_to_config(
                self.full_spin.get_value_as_int()),
            "DEBOUNCE": self.cfg.get("DEBOUNCE", "30"),
            "SYNC_DELETES": "true" if self.del_switch.get_active() else "false",
        })
        if self.cli:
            self.cfg["PROTON_DRIVE_CLI"] = self.cli
        save_config(self.cfg)
        save_excludes(self.current_excludes())
        set_autostart(self.auto_switch.get_active())
        if daemon_running():
            # The daemon re-reads the config before every pass.
            request_sync()
            self.flash("Settings saved — syncing with the new settings.")
        else:
            self.flash("Settings saved.")
        self._refresh_exclude_labels()
        self.refresh_checks()
        self.refresh_activity()

    def on_sync_now(self, _btn):
        # The daemon decides on its own whether this is a quick sync or the
        # periodic re-verification of all files.
        if self.sync_proc is not None and self.sync_proc.poll() is None:
            return
        if daemon_running():
            state = (read_status() or {}).get("state", "")
            if state in BUSY_STATES:
                self.flash("A sync is already running.")
                return
            request_sync()
            self.flash("Sync requested — it starts in a moment.")
            return
        self.sync_btn.set_sensitive(False)
        self.flash("Syncing…")
        self.sync_proc = subprocess.Popen(
            [daemon_path(), "--once"],
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
        )
        GLib.timeout_add(1000, self._poll_sync)

    def _poll_sync(self):
        if self.sync_proc is not None and self.sync_proc.poll() is None:
            return True
        self.sync_proc = None
        self.flash("Sync finished.")
        self.refresh_activity()
        return False

    def on_open_log(self, _btn):
        if not os.path.exists(LOG_FILE):
            self.flash("No log yet — nothing has been synced so far.")
            return
        Gtk.show_uri_on_window(self, "file://" + LOG_FILE,
                               Gtk.get_current_event_time())

    def flash(self, text, seconds=4):
        self.toast_label.set_text(text)
        self.toast.set_reveal_child(True)
        if self._toast_timeout:
            GLib.source_remove(self._toast_timeout)
        self._toast_timeout = GLib.timeout_add_seconds(seconds, self._hide_toast)

    def _hide_toast(self):
        self.toast.set_reveal_child(False)
        self._toast_timeout = None
        return False

    # ---- checks (login + autostart probe in a thread, service inline)
    def refresh_checks(self):
        if not self._started:
            return True
        self._update_service_row(daemon_running())
        if self._check_thread is None or not self._check_thread.is_alive():
            self._check_thread = threading.Thread(target=self._run_checks,
                                                  daemon=True)
            self._check_thread.start()
        return True

    def _run_checks(self):
        autostart = autostart_enabled()
        login = probe_login(self.cli)
        GLib.idle_add(self._apply_checks, autostart, login)

    def _apply_checks(self, autostart, login):
        self._autostart = autostart
        self.check_rows["autostart"].set_content(*autostart_check_result(autostart))
        self.check_rows["login"].set_content(*login)
        self._update_service_row(daemon_running())
        return False

    def _update_service_row(self, running):
        self.check_rows["service"].set_content(
            *service_check_result(running, self._autostart))

    # ---- activity page refresh
    def refresh_activity(self):
        if not self._started:
            return True
        status = read_status() or {}
        running = daemon_running()
        root = self.cfg.get("LOCAL_ROOT", "")
        state = status.get("state", "")
        if not running and state in ACTIVE_STATES:
            state = "stopped"
        color, text = state_title(state, status)
        self.state_label.set_markup(
            f'<span foreground="{color}">●</span>  <b>{esc(text)}</b>')
        self.state_detail.set_text(self._state_detail(state, status, root))

        manual = self.sync_proc is not None and self.sync_proc.poll() is None
        self.sync_btn.set_sensitive(not manual and state not in BUSY_STATES)

        rows = read_queue()
        self._update_queue(rows, running, root)
        self._update_live(read_events(), root)
        in_progress = running and state in BUSY_STATES
        if status:
            self.files_heading.set_subtitle(
                ("This sync: " if in_progress else "Last sync: ")
                + pass_summary(status, in_progress))
        self.files_heading.set_info(queue_summary(rows, running))

        self._update_problems(describe_problems(
            status, rows, running,
            poll_minutes_from_config(self.cfg.get("POLL_INTERVAL")),
            root, login_command(self.cli)))

        self.history_heading.set_info(total_summary(status) if status else "")
        if self.chart is not None:
            self.chart.set_history(read_history())

        text = read_log_tail()
        if text != self._log_cache:
            self._log_cache = text
            buf = self.log_view.get_buffer()
            adj = self.log_view.get_parent().get_vadjustment()
            at_bottom = (adj.get_value() + adj.get_page_size()
                         >= adj.get_upper() - 40)
            buf.set_text(text)
            if at_bottom:
                GLib.idle_add(self._scroll_log_to_end)
        self._update_service_row(running)
        return True

    @staticmethod
    def _state_detail(state, status, root):
        current = str(status.get("current", "") or "")
        if state == "syncing":
            prefix = "Checking all files · " if status.get("mode") == "full" else ""
            if not current:
                return prefix + "Preparing…"
            text = prefix + "Uploading " + relative_name(current, root)
            file = str(status.get("file", "") or "")
            if file and file != current and file.startswith(current + "/"):
                text += " · " + file[len(current) + 1:]
            return text
        if state == "debouncing":
            return "Sync starts in a moment"
        if state == "error":
            return current
        if state in ("watching", "polling", "idle"):
            return "Last sync finished at " + fmt_time(status.get("ts"))
        if state == "stopped":
            return "Since " + fmt_time(status.get("ts"))
        return ""

    def _update_queue(self, rows, running, root):
        key = (tuple((r["state"], r["path"]) for r in rows), running, root)
        if key == self._queue_cache:
            return
        self._queue_cache = key
        if not rows:
            self.files_stack.set_visible_child_name("empty")
            return
        self.files_stack.set_visible_child_name("list")
        self.queue_store.clear()
        current = None
        for r in rows:
            severity = {"done": "ok", "failed": "fail", "pending": "queued",
                        "unchanged": "unchanged",
                        "uploading": "busy" if running else "queued"}[r["state"]]
            color, glyph = GLYPHS[severity]
            tip = r["path"] + (f"\n{r['note']}" if r["note"] else "")
            it = self.queue_store.append([
                f'<span foreground="{color}" weight="bold">{glyph}</span>',
                relative_name(r["path"], root), esc(tip)])
            if r["state"] == "uploading" and running:
                current = self.queue_store.get_path(it)
        if current is not None:
            self.queue_view.scroll_to_cell(current, None, False, 0, 0)

    def _update_live(self, events, root):
        key = (len(events), events[-1] if events else None, root)
        if key == self._live_cache:
            return
        self._live_cache = key
        if not events:
            self.live_stack.set_visible_child_name("empty")
            return
        self.live_stack.set_visible_child_name("list")
        self.live_store.clear()
        login_cmd = login_command(self.cli)
        for ts, kind, path, detail in reversed(events):
            severity, text, secondary = describe_event(kind, path, detail,
                                                       root, login_cmd)
            color, glyph = GLYPHS[severity]
            tip = esc(path or text) + (f"\n{esc(detail)}" if detail else "")
            markup = esc(text)
            if secondary:
                markup += f'  <span foreground="#868e96"><small>{esc(secondary)}</small></span>'
            self.live_store.append([
                fmt_time(ts),
                f'<span foreground="{color}" weight="bold">{glyph}</span>',
                markup, tip])

    def _update_problems(self, problems):
        if problems == self._problems_cache:
            return
        self._problems_cache = problems
        for child in self.problem_box.get_children():
            self.problem_box.remove(child)
        if not problems:
            row = NoteRow()
            row.set_content("ok", "No problems")
            self.problem_box.pack_start(row, False, False, 0)
        for severity, title, advice, details in problems:
            row = NoteRow(selectable=True)
            row.set_content(severity, title, advice, details)
            self.problem_box.pack_start(row, False, False, 0)
        self.problem_box.show_all()

    def _scroll_log_to_end(self):
        buf = self.log_view.get_buffer()
        self.log_view.scroll_to_iter(buf.get_end_iter(), 0.0, False, 0, 0)
        return False


class App(Gtk.Application):
    def __init__(self):
        super().__init__(application_id="dev.unofficial.ProtonSync")

    def do_activate(self):
        win = self.get_active_window() or SettingsWindow(self)
        win.show_all()
        win.present()


if __name__ == "__main__":
    sys.exit(App().run(sys.argv))
