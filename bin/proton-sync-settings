#!/usr/bin/env python3
"""Proton Sync (unofficial) — settings + live sync activity UI.

Settings page edits the config consumed by proton-sync-daemon and manages the
background service (systemd user unit outside a snap, snap autostart inside
one). Activity page visualizes the daemon's status.json / history.jsonl.
"""

import fcntl
import json
import os
import shlex
import shutil
import signal
import subprocess
import sys
import threading
import time

import gi

gi.require_version("Gtk", "3.0")
from gi.repository import GLib, Gtk  # noqa: E402

# The pass chart needs the GTK<->cairo bridge (python3-gi-cairo). Everything
# else on the Activity page works without it.
try:
    gi.require_foreign("cairo")
    HAVE_CAIRO = True
except ImportError:
    HAVE_CAIRO = False

# True only when this app itself is the snap (not when merely launched from
# a terminal whose environment belongs to another snap, e.g. VS Code).
_snap = os.environ.get("SNAP", "")
IS_SNAP = bool(_snap) and os.path.abspath(__file__).startswith(_snap + os.sep)

CONFIG_DIR = os.path.join(GLib.get_user_config_dir(), "proton-sync")
CONFIG_FILE = os.path.join(CONFIG_DIR, "config")
EXCLUDES_FILE = os.path.join(CONFIG_DIR, "excludes.list")
STATE_DIR = os.path.join(
    os.environ.get("XDG_STATE_HOME", os.path.expanduser("~/.local/state")),
    "proton-sync",
)
LOG_FILE = os.path.join(STATE_DIR, "sync.log")
LOCK_FILE = os.path.join(STATE_DIR, "daemon.lock")
PID_FILE = os.path.join(STATE_DIR, "daemon.pid")
STATUS_FILE = os.path.join(STATE_DIR, "status.json")
HISTORY_FILE = os.path.join(STATE_DIR, "history.jsonl")
SCRIPT_DIR = os.path.dirname(os.path.abspath(__file__))
SYSTEMD_UNIT = os.path.expanduser("~/.config/systemd/user/proton-sync.service")
SNAP_AUTOSTART = os.path.join(
    os.environ.get("SNAP_USER_DATA", os.path.expanduser("~")),
    ".config", "autostart", "proton-sync-daemon.desktop",
)

BAR_COLOR = (0x6D / 255, 0x4A / 255, 0xFF / 255)  # #6d4aff, validated
CHART_PASSES = 24

STATE_TEXT = {
    "syncing":      ("#6d4aff", "Syncing"),
    "debouncing":   ("#6d4aff", "Change detected — waiting for files to settle"),
    "watching":     ("#2f9e44", "Watching for changes (instant)"),
    "polling":      ("#2f9e44", "Watching for changes (periodic check)"),
    "idle":         ("#868e96", "Idle — manual sync finished"),
    "stopped":      ("#868e96", "Stopped"),
    "logged-out":   ("#e8590c", "Not logged in to Proton Drive"),
    "unconfigured": ("#e8590c", "Not configured yet — save your settings"),
    "error":        ("#e03131", "Error"),
}


# ------------------------------------------------------------ config I/O ---
def load_config():
    cfg = {}
    try:
        with open(CONFIG_FILE) as f:
            for line in f:
                line = line.strip()
                if not line or line.startswith("#") or "=" not in line:
                    continue
                key, _, raw = line.partition("=")
                try:
                    cfg[key.strip()] = shlex.split(raw)[0] if raw else ""
                except ValueError:
                    pass
    except FileNotFoundError:
        pass
    return cfg


def save_config(cfg):
    os.makedirs(CONFIG_DIR, exist_ok=True)
    with open(CONFIG_FILE, "w") as f:
        f.write("# Written by the Proton Sync settings app.\n")
        for key, val in cfg.items():
            quoted = "'" + str(val).replace("'", "'\\''") + "'"
            f.write(f"{key}={quoted}\n")


def load_excludes():
    try:
        with open(EXCLUDES_FILE) as f:
            return [l.strip() for l in f if l.strip() and not l.startswith("#")]
    except FileNotFoundError:
        return []


def save_excludes(paths):
    os.makedirs(CONFIG_DIR, exist_ok=True)
    with open(EXCLUDES_FILE, "w") as f:
        f.write("# Folders excluded from sync (absolute paths, one per line).\n")
        for p in paths:
            f.write(p + "\n")


# --------------------------------------------------------------- backend ---
def find_cli(cfg):
    candidates = [
        cfg.get("PROTON_DRIVE_CLI", ""),
        os.path.join(_snap, "bin", "proton-drive") if IS_SNAP else "",
        os.path.join(SCRIPT_DIR, "proton-drive"),
        os.path.join(SCRIPT_DIR, "..", "proton-drive"),
        shutil.which("proton-drive") or "",
    ]
    for c in candidates:
        if c and os.access(c, os.X_OK):
            return os.path.abspath(c)
    return None


def daemon_path():
    return os.path.join(SCRIPT_DIR, "proton-sync-daemon")


def daemon_running():
    os.makedirs(STATE_DIR, exist_ok=True)
    try:
        with open(LOCK_FILE, "w") as f:
            try:
                fcntl.flock(f, fcntl.LOCK_EX | fcntl.LOCK_NB)
            except BlockingIOError:
                return True
            fcntl.flock(f, fcntl.LOCK_UN)
            return False
    except OSError:
        return False


def stop_daemon():
    try:
        with open(PID_FILE) as f:
            pid = int(f.read().strip())
        os.killpg(pid, signal.SIGTERM)
    except (FileNotFoundError, ValueError, ProcessLookupError, PermissionError):
        pass


def start_daemon():
    subprocess.Popen(
        [daemon_path()],
        start_new_session=True,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )


def set_autostart(enabled):
    """Register/unregister the daemon to start at login, and apply now."""
    if IS_SNAP:
        if enabled:
            os.makedirs(os.path.dirname(SNAP_AUTOSTART), exist_ok=True)
            snap_name = os.environ.get("SNAP_NAME", "proton-sync")
            with open(SNAP_AUTOSTART, "w") as f:
                f.write(
                    "[Desktop Entry]\n"
                    "Type=Application\n"
                    "Name=Proton Sync daemon\n"
                    f"Exec=/snap/bin/{snap_name}.daemon\n"
                    "NoDisplay=true\n"
                    "X-GNOME-Autostart-enabled=true\n"
                )
            if not daemon_running():
                start_daemon()
        else:
            try:
                os.remove(SNAP_AUTOSTART)
            except FileNotFoundError:
                pass
            stop_daemon()
        return

    if enabled:
        os.makedirs(os.path.dirname(SYSTEMD_UNIT), exist_ok=True)
        with open(SYSTEMD_UNIT, "w") as f:
            f.write(
                "[Unit]\n"
                "Description=Proton Drive folder sync (unofficial)\n"
                "After=network-online.target\n\n"
                "[Service]\n"
                "Type=simple\n"
                f"ExecStart={daemon_path()}\n"
                "Restart=always\n"
                "RestartSec=120\n\n"
                "[Install]\n"
                "WantedBy=default.target\n"
            )
        subprocess.run(["systemctl", "--user", "daemon-reload"], check=False)
        subprocess.run(
            ["systemctl", "--user", "enable", "--now", "proton-sync.service"],
            check=False,
        )
    else:
        subprocess.run(
            ["systemctl", "--user", "disable", "--now", "proton-sync.service"],
            check=False,
        )
        stop_daemon()


def autostart_enabled():
    if IS_SNAP:
        return os.path.exists(SNAP_AUTOSTART)
    r = subprocess.run(
        ["systemctl", "--user", "is-enabled", "proton-sync.service"],
        capture_output=True, text=True,
    )
    return r.stdout.strip() == "enabled"


def read_status():
    try:
        with open(STATUS_FILE) as f:
            return json.load(f)
    except (OSError, ValueError):
        return None


def read_history(n=CHART_PASSES):
    rows = []
    try:
        with open(HISTORY_FILE) as f:
            lines = f.readlines()[-n:]
        for line in lines:
            try:
                rows.append(json.loads(line))
            except ValueError:
                pass
    except OSError:
        pass
    return rows


def read_log_tail(max_bytes=8192, max_lines=150):
    try:
        with open(LOG_FILE, "rb") as f:
            f.seek(0, os.SEEK_END)
            size = f.tell()
            f.seek(max(0, size - max_bytes))
            data = f.read().decode("utf-8", "replace")
        lines = data.splitlines()
        if size > max_bytes and lines:
            lines = lines[1:]  # drop the partial first line
        return "\n".join(lines[-max_lines:])
    except OSError:
        return ""


def human_bytes(n):
    n = float(n)
    for unit in ("B", "KiB", "MiB", "GiB", "TiB"):
        if n < 1024 or unit == "TiB":
            return f"{n:.0f} {unit}" if unit == "B" else f"{n:.1f} {unit}"
        n /= 1024


def fmt_time(epoch):
    if not epoch:
        return "—"
    return time.strftime("%H:%M:%S", time.localtime(epoch))


# ----------------------------------------------------------------- chart ---
class PassChart(Gtk.DrawingArea):
    """Bar chart: data uploaded per sync pass (single series, direct label)."""

    def __init__(self):
        super().__init__()
        self.history = []
        self._bars = []  # (x0, x1, record) hit boxes for tooltips
        self.set_size_request(-1, 130)
        self.set_has_tooltip(True)
        self.connect("draw", self.on_draw)
        self.connect("query-tooltip", self.on_tooltip)

    def set_history(self, rows):
        if rows != self.history:
            self.history = rows
            self.queue_draw()

    def on_tooltip(self, _w, x, _y, _kbd, tooltip):
        for x0, x1, rec in self._bars:
            if x0 <= x <= x1:
                err = f", {rec['errors']} errors" if rec.get("errors") else ""
                dur = max(0, rec.get("end", 0) - rec.get("start", 0))
                tooltip.set_text(
                    f"{fmt_time(rec.get('end'))} — {rec.get('items', 0)} items, "
                    f"{human_bytes(rec.get('bytes', 0))}{err}, {dur}s"
                )
                return True
        return False

    def on_draw(self, widget, cr):
        w = widget.get_allocated_width()
        h = widget.get_allocated_height()
        style = widget.get_style_context()
        fg = style.get_color(Gtk.StateFlags.NORMAL)
        pad_top, pad_bottom, pad_x = 18, 20, 6
        base_y = h - pad_bottom
        self._bars = []

        cr.select_font_face("sans")
        cr.set_font_size(11)

        if not self.history:
            cr.set_source_rgba(fg.red, fg.green, fg.blue, 0.55)
            msg = "No completed sync passes yet"
            ext = cr.text_extents(msg)
            cr.move_to((w - ext.width) / 2, h / 2)
            cr.show_text(msg)
            return

        # baseline (recessive)
        cr.set_source_rgba(fg.red, fg.green, fg.blue, 0.25)
        cr.set_line_width(1)
        cr.move_to(pad_x, base_y + 0.5)
        cr.line_to(w - pad_x, base_y + 0.5)
        cr.stroke()

        rows = self.history[-CHART_PASSES:]
        n = CHART_PASSES
        gap = 2.0
        slot = (w - 2 * pad_x) / n
        bw = max(2.0, slot - gap)
        max_bytes = max((r.get("bytes", 0) for r in rows), default=0)
        max_h = base_y - pad_top
        # right-align so the newest pass sits at the right edge
        x = w - pad_x - slot * len(rows)

        max_idx = None
        if max_bytes > 0:
            max_idx = max(range(len(rows)), key=lambda i: rows[i].get("bytes", 0))

        for i, rec in enumerate(rows):
            frac = (rec.get("bytes", 0) / max_bytes) if max_bytes else 0
            bh = max(2.0, frac * max_h)  # 2px stub so empty passes stay visible
            bx = x + i * slot + gap / 2
            by = base_y - bh
            r = min(3.0, bw / 2, bh)
            cr.new_sub_path()
            cr.arc(bx + r, by + r, r, 3.14159, 1.5 * 3.14159)
            cr.arc(bx + bw - r, by + r, r, 1.5 * 3.14159, 2 * 3.14159)
            cr.line_to(bx + bw, base_y)
            cr.line_to(bx, base_y)
            cr.close_path()
            cr.set_source_rgb(*BAR_COLOR)
            cr.fill()
            self._bars.append((bx, bx + bw, rec))

            if i == max_idx and rec.get("bytes", 0) > 0:
                label = human_bytes(rec["bytes"])
                ext = cr.text_extents(label)
                lx = min(max(pad_x, bx + bw / 2 - ext.width / 2),
                         w - pad_x - ext.width)
                cr.set_source_rgba(fg.red, fg.green, fg.blue, 0.75)
                cr.move_to(lx, by - 5)
                cr.show_text(label)

        cr.set_source_rgba(fg.red, fg.green, fg.blue, 0.55)
        cr.move_to(pad_x, h - 6)
        cr.show_text("older")
        lbl = "latest"
        ext = cr.text_extents(lbl)
        cr.move_to(w - pad_x - ext.width, h - 6)
        cr.show_text(lbl)


# -------------------------------------------------------------------- UI ---
class SettingsWindow(Gtk.ApplicationWindow):
    def __init__(self, app):
        super().__init__(application=app, title="Proton Sync")
        self.set_default_size(600, 680)
        self.cfg = load_config()
        self.cli = find_cli(self.cfg)
        self.sync_proc = None
        self._log_cache = None

        header = Gtk.HeaderBar(show_close_button=True)
        self.set_titlebar(header)
        self.save_btn = Gtk.Button(label="Save")
        self.save_btn.get_style_context().add_class("suggested-action")
        self.save_btn.connect("clicked", self.on_save)
        header.pack_end(self.save_btn)

        self.stack = Gtk.Stack(
            transition_type=Gtk.StackTransitionType.SLIDE_LEFT_RIGHT)
        switcher = Gtk.StackSwitcher(stack=self.stack)
        header.set_custom_title(switcher)
        self.add(self.stack)

        self.stack.add_titled(self._build_settings_page(), "settings",
                              "Settings")
        self.stack.add_titled(self._build_activity_page(), "activity",
                              "Activity")

        self.refresh_status()
        self.refresh_activity()
        GLib.timeout_add_seconds(10, self.refresh_status)
        GLib.timeout_add_seconds(2, self.refresh_activity)

    # ------------------------------------------------------ settings page --
    def _build_settings_page(self):
        outer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12,
                        margin=18)

        grid = Gtk.Grid(column_spacing=12, row_spacing=10)
        outer.pack_start(grid, False, False, 0)

        grid.attach(self._label("Folder to sync"), 0, 0, 1, 1)
        self.folder_btn = Gtk.FileChooserButton(
            title="Select folder to sync",
            action=Gtk.FileChooserAction.SELECT_FOLDER,
        )
        self.folder_btn.set_hexpand(True)
        local_root = self.cfg.get("LOCAL_ROOT", "")
        if local_root:
            self.folder_btn.set_filename(local_root)
        grid.attach(self.folder_btn, 1, 0, 1, 1)

        grid.attach(self._label("Folder name on Proton Drive"), 0, 1, 1, 1)
        self.remote_entry = Gtk.Entry(hexpand=True)
        self.remote_entry.set_text(self.cfg.get("REMOTE_ROOT", ""))
        self.remote_entry.set_placeholder_text("/my-files/Desktop")
        grid.attach(self.remote_entry, 1, 1, 1, 1)

        grid.attach(self._label("Fallback check interval (seconds)"), 0, 2, 1, 1)
        adj = Gtk.Adjustment(value=int(self.cfg.get("POLL_INTERVAL", 300) or 300),
                             lower=30, upper=3600, step_increment=30)
        self.poll_spin = Gtk.SpinButton(adjustment=adj, numeric=True)
        grid.attach(self.poll_spin, 1, 2, 1, 1)

        grid.attach(self._label("Sync automatically in the background"), 0, 3, 1, 1)
        self.auto_switch = Gtk.Switch(halign=Gtk.Align.START)
        self.auto_switch.set_active(autostart_enabled())
        grid.attach(self.auto_switch, 1, 3, 1, 1)

        del_label = self._label("Sync deletions")
        del_label.set_tooltip_text(
            "When a file is deleted locally, move it to the Proton Drive "
            "trash on the next pass. It stays recoverable in the trash. "
            "When off, deleted files simply remain on Proton Drive.")
        grid.attach(del_label, 0, 4, 1, 1)
        self.del_switch = Gtk.Switch(halign=Gtk.Align.START)
        self.del_switch.set_tooltip_text(del_label.get_tooltip_text())
        self.del_switch.set_active(
            self.cfg.get("SYNC_DELETES", "false") == "true")
        grid.attach(self.del_switch, 1, 4, 1, 1)

        frame = Gtk.Frame(label="Excluded folders (not synced)")
        outer.pack_start(frame, True, True, 0)
        fbox = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6,
                       margin=8)
        frame.add(fbox)
        scroll = Gtk.ScrolledWindow(min_content_height=110)
        self.excl_list = Gtk.ListBox(selection_mode=Gtk.SelectionMode.SINGLE)
        scroll.add(self.excl_list)
        fbox.pack_start(scroll, True, True, 0)
        for p in load_excludes():
            self._add_exclude_row(p)
        btns = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        add_btn = Gtk.Button(label="Add folder…")
        add_btn.connect("clicked", self.on_add_exclude)
        rm_btn = Gtk.Button(label="Remove selected")
        rm_btn.connect("clicked", self.on_remove_exclude)
        btns.pack_start(add_btn, False, False, 0)
        btns.pack_start(rm_btn, False, False, 0)
        fbox.pack_start(btns, False, False, 0)

        actions = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        outer.pack_start(actions, False, False, 0)
        self.sync_btn = Gtk.Button(label="Sync now")
        self.sync_btn.connect("clicked", self.on_sync_now)
        log_btn = Gtk.Button(label="Open log")
        log_btn.connect("clicked", self.on_open_log)
        actions.pack_start(self.sync_btn, False, False, 0)
        actions.pack_start(log_btn, False, False, 0)

        self.status = Gtk.Label(xalign=0, wrap=True)
        self.status.get_style_context().add_class("dim-label")
        outer.pack_end(self.status, False, False, 0)
        return outer

    # ------------------------------------------------------ activity page --
    def _build_activity_page(self):
        outer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12,
                        margin=18)

        self.state_label = Gtk.Label(xalign=0)
        self.state_label.set_markup("<b>…</b>")
        outer.pack_start(self.state_label, False, False, 0)
        self.state_detail = Gtk.Label(xalign=0, wrap=True,
                                      ellipsize=3)  # PANGO_ELLIPSIZE_END
        self.state_detail.get_style_context().add_class("dim-label")
        outer.pack_start(self.state_detail, False, False, 0)

        cgrid = Gtk.Grid(column_spacing=24, row_spacing=4)
        outer.pack_start(cgrid, False, False, 0)
        self.counter_labels = {}
        cols = [
            ("pass", "Current / last pass"),
            ("total", "Since service start"),
        ]
        for col, (key, title) in enumerate(cols):
            t = Gtk.Label(xalign=0)
            t.set_markup(f"<b>{title}</b>")
            cgrid.attach(t, col, 0, 1, 1)
            val = Gtk.Label(xalign=0)
            val.set_text("—")
            self.counter_labels[key] = val
            cgrid.attach(val, col, 1, 1, 1)

        chart_frame = Gtk.Frame(
            label=f"Data uploaded per sync pass (last {CHART_PASSES})")
        if HAVE_CAIRO:
            self.chart = PassChart()
            chart_frame.add(self.chart)
        else:
            self.chart = None
            hint = Gtk.Label(
                label="Install python3-gi-cairo to see the chart:\n"
                      "sudo apt install python3-gi-cairo",
                justify=Gtk.Justification.CENTER, margin=20)
            hint.get_style_context().add_class("dim-label")
            chart_frame.add(hint)
        outer.pack_start(chart_frame, False, False, 0)

        log_frame = Gtk.Frame(label="Recent log")
        lbox = Gtk.ScrolledWindow(min_content_height=160)
        self.log_view = Gtk.TextView(editable=False, cursor_visible=False,
                                     monospace=True)
        self.log_view.set_wrap_mode(Gtk.WrapMode.NONE)
        lbox.add(self.log_view)
        log_frame.add(lbox)
        outer.pack_start(log_frame, True, True, 0)
        return outer

    @staticmethod
    def _label(text):
        return Gtk.Label(label=text, xalign=0)

    # ---- excludes list helpers
    def _add_exclude_row(self, path):
        row = Gtk.ListBoxRow()
        row.path = path
        row.add(Gtk.Label(label=path, xalign=0, margin=4,
                          ellipsize=3))  # PANGO_ELLIPSIZE_END
        self.excl_list.add(row)
        self.excl_list.show_all()

    def current_excludes(self):
        return [row.path for row in self.excl_list.get_children()]

    def on_add_exclude(self, _btn):
        dlg = Gtk.FileChooserDialog(
            title="Folder to exclude from sync", parent=self,
            action=Gtk.FileChooserAction.SELECT_FOLDER,
        )
        dlg.add_buttons("Cancel", Gtk.ResponseType.CANCEL,
                        "Exclude", Gtk.ResponseType.OK)
        root = self.folder_btn.get_filename()
        if root:
            dlg.set_current_folder(root)
        if dlg.run() == Gtk.ResponseType.OK:
            path = dlg.get_filename()
            if path and path not in self.current_excludes():
                self._add_exclude_row(path)
        dlg.destroy()

    def on_remove_exclude(self, _btn):
        row = self.excl_list.get_selected_row()
        if row:
            self.excl_list.remove(row)

    # ---- actions
    def on_save(self, _btn):
        local_root = self.folder_btn.get_filename() or ""
        if not local_root:
            self.flash("Choose a folder to sync first.")
            return
        remote = self.remote_entry.get_text().strip()
        if not remote:
            remote = "/" + os.path.basename(local_root)
        if not remote.startswith("/"):
            remote = "/" + remote
        # Proton Drive namespaces user files under /my-files.
        if remote != "/my-files" and not remote.startswith("/my-files/"):
            remote = "/my-files" + remote
        self.cfg.update({
            "LOCAL_ROOT": local_root,
            "REMOTE_ROOT": remote,
            "POLL_INTERVAL": str(self.poll_spin.get_value_as_int()),
            "DEBOUNCE": self.cfg.get("DEBOUNCE", "30"),
            "SYNC_DELETES": "true" if self.del_switch.get_active() else "false",
        })
        if self.cli:
            self.cfg["PROTON_DRIVE_CLI"] = self.cli
        save_config(self.cfg)
        save_excludes(self.current_excludes())
        set_autostart(self.auto_switch.get_active())
        self.flash("Settings saved.")
        self.refresh_status()

    def on_sync_now(self, _btn):
        if self.sync_proc and self.sync_proc.poll() is None:
            return
        if daemon_running():
            self.flash("The background service is running — it syncs "
                       "automatically when files change.")
            return
        self.sync_btn.set_sensitive(False)
        self.flash("Syncing…")
        self.sync_proc = subprocess.Popen(
            [daemon_path(), "--once"],
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
        )
        GLib.timeout_add(1000, self._poll_sync)

    def _poll_sync(self):
        if self.sync_proc and self.sync_proc.poll() is None:
            return True
        self.sync_btn.set_sensitive(True)
        self.flash("Sync finished — see the Activity tab for details.")
        return False

    def on_open_log(self, _btn):
        if not os.path.exists(LOG_FILE):
            self.flash("No log yet — nothing has been synced so far.")
            return
        Gtk.show_uri_on_window(self, "file://" + LOG_FILE,
                               Gtk.get_current_event_time())

    def flash(self, text):
        self.status.set_text(text)

    # ---- settings status line (login check)
    def refresh_status(self):
        parts = []
        if not self.cli:
            parts.append("⚠ proton-drive binary not found.")
        parts.append("Service: " +
                     ("running" if daemon_running() else "not running"))
        self.status.set_text("   ".join(parts))
        threading.Thread(target=self._check_login, daemon=True).start()
        return True

    def _check_login(self):
        if not self.cli:
            return
        try:
            r = subprocess.run([self.cli, "filesystem", "list", "/"],
                               capture_output=True, text=True, timeout=60)
            if r.returncode == 0:
                msg = "Account: logged in ✓"
            elif "You need to login first" in (r.stdout + r.stderr):
                msg = ("Account: NOT logged in — run in a terminal:  "
                       f"{self.cli} auth login")
            else:
                msg = "Account: check failed (offline?)"
        except (subprocess.TimeoutExpired, OSError):
            msg = "Account: check failed"
        GLib.idle_add(self._append_status, msg)

    def _append_status(self, msg):
        current = self.status.get_text().split("\n")[0]
        self.status.set_text(current + "\n" + msg)
        return False

    # ---- activity page refresh
    def refresh_activity(self):
        status = read_status()
        running = daemon_running()

        state = (status or {}).get("state", "")
        if not running and state in ("syncing", "watching", "polling",
                                     "debouncing"):
            state = "stopped"
        color, text = STATE_TEXT.get(
            state, ("#868e96", "No sync activity recorded yet"))
        self.state_label.set_markup(
            f'<span foreground="{color}">●</span>  <b>{GLib.markup_escape_text(text)}</b>')

        detail = ""
        if status:
            if state == "syncing" and status.get("current"):
                detail = "Uploading: " + status["current"]
            elif state == "error" and status.get("current"):
                detail = status["current"]
            elif state in ("watching", "polling", "stopped", "idle"):
                detail = "Status updated " + fmt_time(status.get("ts"))
        self.state_detail.set_text(detail)

        if status:
            self.counter_labels["pass"].set_text(
                f"{status.get('pass_items', 0)} items · "
                f"{human_bytes(status.get('pass_bytes', 0))} · "
                f"{status.get('pass_trashed', 0)} deleted · "
                f"{status.get('pass_errors', 0)} errors · "
                f"started {fmt_time(status.get('pass_started'))}"
            )
            self.counter_labels["total"].set_text(
                f"{status.get('passes_done', 0)} passes · "
                f"{status.get('total_items', 0)} items · "
                f"{human_bytes(status.get('total_bytes', 0))} · "
                f"{status.get('total_trashed', 0)} deleted · "
                f"{status.get('total_errors', 0)} errors"
            )

        if self.chart is not None:
            self.chart.set_history(read_history())

        text = read_log_tail()
        if text != self._log_cache:
            self._log_cache = text
            buf = self.log_view.get_buffer()
            sw = self.log_view.get_parent()
            adj = sw.get_vadjustment()
            at_bottom = (adj.get_value() + adj.get_page_size()
                         >= adj.get_upper() - 40)
            buf.set_text(text)
            if at_bottom:
                GLib.idle_add(self._scroll_log_to_end)
        return True

    def _scroll_log_to_end(self):
        buf = self.log_view.get_buffer()
        self.log_view.scroll_to_iter(buf.get_end_iter(), 0.0, False, 0, 0)
        return False


class App(Gtk.Application):
    def __init__(self):
        super().__init__(application_id="dev.unofficial.ProtonSync")

    def do_activate(self):
        win = self.get_active_window() or SettingsWindow(self)
        win.show_all()
        win.present()


if __name__ == "__main__":
    sys.exit(App().run(sys.argv))
