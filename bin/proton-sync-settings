#!/usr/bin/env python3
"""Proton Sync (unofficial) — settings + activity UI.

Settings page edits the config consumed by proton-sync-daemon and manages
the background service (systemd user unit outside a snap, snap autostart
inside one). Activity page turns the daemon's status.json / queue.tsv /
history.jsonl into something a non-technical user can read: live state,
health checks, problems with suggested fixes, the upload queue and, folded
away, the raw log.
"""

import fcntl
import json
import os
import shlex
import shutil
import signal
import subprocess
import sys
import threading
import time

import gi

gi.require_version("Gtk", "3.0")
gi.require_version("Pango", "1.0")
from gi.repository import GLib, Gtk, Pango  # noqa: E402

# The pass chart needs the GTK<->cairo bridge (python3-gi-cairo). Everything
# else on the Activity page works without it.
try:
    gi.require_foreign("cairo")
    HAVE_CAIRO = True
except ImportError:
    HAVE_CAIRO = False

# True only when this app itself is the snap (not when merely launched from
# a terminal whose environment belongs to another snap, e.g. VS Code).
_snap = os.environ.get("SNAP", "")
IS_SNAP = bool(_snap) and os.path.abspath(__file__).startswith(_snap + os.sep)
SNAP_NAME = os.environ.get("SNAP_NAME", "proton-sync")

CONFIG_DIR = os.path.join(GLib.get_user_config_dir(), "proton-sync")
CONFIG_FILE = os.path.join(CONFIG_DIR, "config")
EXCLUDES_FILE = os.path.join(CONFIG_DIR, "excludes.list")
STATE_DIR = os.path.join(
    os.environ.get("XDG_STATE_HOME", os.path.expanduser("~/.local/state")),
    "proton-sync",
)
LOG_FILE = os.path.join(STATE_DIR, "sync.log")
LOCK_FILE = os.path.join(STATE_DIR, "daemon.lock")
PID_FILE = os.path.join(STATE_DIR, "daemon.pid")
STATUS_FILE = os.path.join(STATE_DIR, "status.json")
HISTORY_FILE = os.path.join(STATE_DIR, "history.jsonl")
QUEUE_FILE = os.path.join(STATE_DIR, "queue.tsv")
EVENTS_FILE = os.path.join(STATE_DIR, "events.tsv")
# Creating this file asks a running daemon for a sync pass right away.
TRIGGER_FILE = os.path.join(STATE_DIR, "trigger", "sync-now")
SCRIPT_DIR = os.path.dirname(os.path.abspath(__file__))
SYSTEMD_UNIT = os.path.expanduser("~/.config/systemd/user/proton-sync.service")
SNAP_AUTOSTART = os.path.join(
    os.environ.get("SNAP_USER_DATA", os.path.expanduser("~")),
    ".config", "autostart", "proton-sync-daemon.desktop",
)

BAR_COLOR = (0x6D / 255, 0x4A / 255, 0xFF / 255)  # #6d4aff, validated
CHART_PASSES = 24
POLL_DEFAULT_SECONDS = 300
FULL_CHECK_DEFAULT_SECONDS = 86400
MAX_PROBLEM_ROWS = 8
LIVE_EVENTS = 400

STATE_TEXT = {
    "syncing":      ("#6d4aff", "Syncing"),
    "debouncing":   ("#6d4aff", "Changes detected"),
    "watching":     ("#2f9e44", "Up to date, watching for changes"),
    "polling":      ("#2f9e44", "Up to date, checking for changes periodically"),
    "idle":         ("#868e96", "Manual sync finished"),
    "stopped":      ("#868e96", "Not running"),
    "logged-out":   ("#e8590c", "Not logged in to Proton Drive"),
    "unconfigured": ("#e8590c", "Not set up yet"),
    "error":        ("#e03131", "Sync paused because of a problem"),
}
ACTIVE_STATES = ("syncing", "debouncing", "watching", "polling")
BUSY_STATES = ("syncing", "debouncing")

# Glyph + color per severity, shared by checks, problems and the file list.
GLYPHS = {
    "ok":      ("#2f9e44", "✓"),
    "fail":    ("#e03131", "✗"),
    "warn":    ("#e8590c", "⚠"),
    "off":     ("#868e96", "–"),
    "pending": ("#868e96", "…"),
    "busy":    ("#6d4aff", "●"),
    "queued":  ("#868e96", "○"),
    "added":   ("#2f9e44", "+"),
    "updated": ("#1c7ed6", "↑"),
    "unchanged": ("#adb5bd", "✓"),
}
QUEUE_STATES = ("pending", "uploading", "done", "failed", "unchanged")
# Live-feed kinds the daemon writes to events.tsv (a test cross-checks them).
EVENT_KINDS = ("pass-start", "pass-end", "uploading", "done", "failed", "retry",
               "new", "updated", "more", "folder", "trashed", "trash-failed")


def esc(text):
    return GLib.markup_escape_text(str(text if text is not None else ""))


# ------------------------------------------------------------ config I/O ---
def load_config():
    cfg = {}
    try:
        with open(CONFIG_FILE) as f:
            for line in f:
                line = line.strip()
                if not line or line.startswith("#") or "=" not in line:
                    continue
                key, _, raw = line.partition("=")
                try:
                    cfg[key.strip()] = shlex.split(raw)[0] if raw else ""
                except ValueError:
                    pass
    except FileNotFoundError:
        pass
    return cfg


def save_config(cfg):
    os.makedirs(CONFIG_DIR, exist_ok=True)
    with open(CONFIG_FILE, "w") as f:
        f.write("# Written by the Proton Sync settings app.\n")
        for key, val in cfg.items():
            quoted = "'" + str(val).replace("'", "'\\''") + "'"
            f.write(f"{key}={quoted}\n")


def load_excludes():
    try:
        with open(EXCLUDES_FILE) as f:
            return [l.strip() for l in f if l.strip() and not l.startswith("#")]
    except FileNotFoundError:
        return []


def save_excludes(paths):
    os.makedirs(CONFIG_DIR, exist_ok=True)
    with open(EXCLUDES_FILE, "w") as f:
        f.write("# Folders excluded from sync (absolute paths, one per line).\n")
        for p in paths:
            f.write(p + "\n")


# POLL_INTERVAL is stored in seconds (the daemon sleeps on it); the UI edits
# whole minutes.
def poll_minutes_from_config(value):
    try:
        seconds = int(value)
    except (TypeError, ValueError):
        seconds = POLL_DEFAULT_SECONDS
    if seconds <= 0:
        seconds = POLL_DEFAULT_SECONDS
    return max(1, int(seconds / 60 + 0.5))


def poll_minutes_to_config(minutes):
    return str(max(1, int(minutes)) * 60)


# FULL_CHECK_INTERVAL is stored in seconds; the UI edits whole hours.
def hours_from_config(value):
    try:
        seconds = int(value)
    except (TypeError, ValueError):
        seconds = FULL_CHECK_DEFAULT_SECONDS
    if seconds <= 0:
        seconds = FULL_CHECK_DEFAULT_SECONDS
    return max(1, int(seconds / 3600 + 0.5))


def hours_to_config(hours):
    return str(max(1, int(hours)) * 3600)


def state_title(state, status):
    """(color, text) for the big state line."""
    return STATE_TEXT.get(state, ("#868e96", "No sync activity yet"))


def relative_name(path, root):
    """Path shown relative to the sync folder; absolute when outside it."""
    root = (root or "").rstrip("/")
    if root and path.startswith(root + "/"):
        return path[len(root) + 1:]
    return path


def plural(n, word):
    return f"{n} {word}" + ("" if n == 1 else "s")


# --------------------------------------------------------------- backend ---
def find_cli(cfg):
    candidates = [
        cfg.get("PROTON_DRIVE_CLI", ""),
        os.path.join(_snap, "bin", "proton-drive") if IS_SNAP else "",
        os.path.join(SCRIPT_DIR, "proton-drive"),
        os.path.join(SCRIPT_DIR, "..", "proton-drive"),
        shutil.which("proton-drive") or "",
    ]
    for c in candidates:
        if c and os.access(c, os.X_OK):
            return os.path.abspath(c)
    return None


def daemon_path():
    return os.path.join(SCRIPT_DIR, "proton-sync-daemon")


def daemon_running():
    os.makedirs(STATE_DIR, exist_ok=True)
    try:
        with open(LOCK_FILE, "w") as f:
            try:
                fcntl.flock(f, fcntl.LOCK_EX | fcntl.LOCK_NB)
            except BlockingIOError:
                return True
            fcntl.flock(f, fcntl.LOCK_UN)
            return False
    except OSError:
        return False


def stop_daemon():
    try:
        with open(PID_FILE) as f:
            pid = int(f.read().strip())
        os.killpg(pid, signal.SIGTERM)
    except (FileNotFoundError, ValueError, ProcessLookupError, PermissionError):
        pass


def start_daemon():
    subprocess.Popen(
        [daemon_path()],
        start_new_session=True,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )


def request_sync(full=False):
    """Ask the running daemon for a pass right away (it watches this file).
    Content "full" asks for a full check instead of a quick sync."""
    os.makedirs(os.path.dirname(TRIGGER_FILE), exist_ok=True)
    with open(TRIGGER_FILE, "w") as f:
        f.write("full" if full else "quick")


def set_autostart(enabled):
    """Register/unregister the daemon to start at login, and apply now."""
    if IS_SNAP:
        if enabled:
            os.makedirs(os.path.dirname(SNAP_AUTOSTART), exist_ok=True)
            with open(SNAP_AUTOSTART, "w") as f:
                f.write(
                    "[Desktop Entry]\n"
                    "Type=Application\n"
                    "Name=Proton Sync daemon\n"
                    f"Exec=/snap/bin/{SNAP_NAME}.daemon\n"
                    "NoDisplay=true\n"
                    "X-GNOME-Autostart-enabled=true\n"
                )
            if not daemon_running():
                start_daemon()
        else:
            try:
                os.remove(SNAP_AUTOSTART)
            except FileNotFoundError:
                pass
            stop_daemon()
        return

    if enabled:
        os.makedirs(os.path.dirname(SYSTEMD_UNIT), exist_ok=True)
        with open(SYSTEMD_UNIT, "w") as f:
            f.write(
                "[Unit]\n"
                "Description=Proton Drive folder sync (unofficial)\n"
                "After=network-online.target\n\n"
                "[Service]\n"
                "Type=simple\n"
                f"ExecStart={daemon_path()}\n"
                "Restart=always\n"
                "RestartSec=120\n\n"
                "[Install]\n"
                "WantedBy=default.target\n"
            )
        subprocess.run(["systemctl", "--user", "daemon-reload"], check=False)
        subprocess.run(
            ["systemctl", "--user", "enable", "--now", "proton-sync.service"],
            check=False,
        )
    else:
        subprocess.run(
            ["systemctl", "--user", "disable", "--now", "proton-sync.service"],
            check=False,
        )
        stop_daemon()


def autostart_enabled():
    if IS_SNAP:
        return os.path.exists(SNAP_AUTOSTART)
    try:
        r = subprocess.run(
            ["systemctl", "--user", "is-enabled", "proton-sync.service"],
            capture_output=True, text=True, timeout=15,
        )
    except (OSError, subprocess.TimeoutExpired):
        return False
    return r.stdout.strip() == "enabled"


def read_status():
    try:
        with open(STATUS_FILE) as f:
            return json.load(f)
    except (OSError, ValueError):
        return None


def read_history(n=CHART_PASSES):
    rows = []
    try:
        with open(HISTORY_FILE) as f:
            lines = f.readlines()[-n:]
        for line in lines:
            try:
                rows.append(json.loads(line))
            except ValueError:
                pass
    except OSError:
        pass
    return rows


def read_queue():
    """queue.tsv -> [{state, path, note}], malformed lines skipped."""
    rows = []
    try:
        with open(QUEUE_FILE) as f:
            for line in f:
                parts = line.rstrip("\n").split("\t")
                if len(parts) < 2 or parts[0] not in QUEUE_STATES or not parts[1]:
                    continue
                rows.append({"state": parts[0], "path": parts[1],
                             "note": parts[2] if len(parts) > 2 else ""})
    except OSError:
        pass
    return rows


def read_events(n=LIVE_EVENTS):
    """Last n lines of events.tsv -> [(epoch, kind, path, detail)], oldest first."""
    rows = []
    try:
        with open(EVENTS_FILE, "rb") as f:
            f.seek(0, os.SEEK_END)
            size = f.tell()
            f.seek(max(0, size - 256 * 1024))
            lines = f.read().decode("utf-8", "replace").splitlines()
        if size > 256 * 1024 and lines:
            lines = lines[1:]
        for line in lines[-n:]:
            parts = line.split("\t")
            if len(parts) < 2 or parts[1] not in EVENT_KINDS:
                continue
            try:
                ts = int(parts[0])
            except ValueError:
                continue
            rows.append((ts, parts[1], parts[2] if len(parts) > 2 else "",
                         parts[3] if len(parts) > 3 else ""))
    except OSError:
        pass
    return rows


def describe_event(kind, path, detail, root="", login_cmd="proton-drive auth login"):
    """One live-feed line -> (severity, text, secondary text)."""
    name = relative_name(path, root) if path else ""
    if kind == "pass-start":
        return ("busy", "Sync started", "checking all files" if detail == "full" else "")
    if kind == "pass-end":
        return ("ok", "Sync finished", detail)
    if kind == "uploading":
        return ("busy", f"Uploading {name}", detail)
    if kind == "done":
        return ("ok", name, detail)
    if kind == "failed":
        return ("fail", describe_failure(name, detail, login_cmd)[0], detail)
    if kind == "retry":
        return ("warn", f"Retrying {name}", detail)
    if kind == "new":
        return ("added", f"Added {name}", "")
    if kind == "updated":
        return ("updated", f"Updated {name}", "")
    if kind == "more":
        return ("off", f"… and {detail} in {name}", "")
    if kind == "folder":
        return ("off", f"Created folder {name}", "")
    if kind == "trashed":
        return ("off", f"Moved to trash {name}", detail)
    if kind == "trash-failed":
        return ("fail", f"Could not move {name} to the trash",
                "It is retried on the next sync.")
    return ("off", f"{kind} {name}", detail)


def read_log_tail(max_bytes=8192, max_lines=150):
    try:
        with open(LOG_FILE, "rb") as f:
            f.seek(0, os.SEEK_END)
            size = f.tell()
            f.seek(max(0, size - max_bytes))
            data = f.read().decode("utf-8", "replace")
        lines = data.splitlines()
        if size > max_bytes and lines:
            lines = lines[1:]  # drop the partial first line
        return "\n".join(lines[-max_lines:])
    except OSError:
        return ""


def human_bytes(n):
    n = float(n)
    for unit in ("B", "KiB", "MiB", "GiB", "TiB"):
        if n < 1024 or unit == "TiB":
            return f"{n:.0f} {unit}" if unit == "B" else f"{n:.1f} {unit}"
        n /= 1024


def fmt_time(epoch):
    """Clock time for today, date + time for anything older."""
    if not epoch:
        return "—"
    t = time.localtime(epoch)
    if t[:3] == time.localtime()[:3]:
        return time.strftime("%H:%M", t)
    return time.strftime("%b %-d, %H:%M", t)


# --------------------------------------------------------- plain-language ---
def login_command(cli):
    if IS_SNAP:
        return f"{SNAP_NAME}.proton-drive auth login"
    return f"{cli or 'proton-drive'} auth login"


def login_check_result(cli, returncode, output):
    """-> (severity, title, advice) for the Checks list."""
    if not cli:
        return ("fail", "Proton Drive CLI not found",
                "Put the proton-drive program next to the app, or point "
                "PROTON_DRIVE_CLI in the config file at it.")
    if returncode == 0:
        return ("ok", "Logged in to Proton Drive", "")
    if returncode is not None and "You need to login first" in output:
        return ("fail", "Not logged in to Proton Drive",
                f"Open a terminal and run:  {login_command(cli)}")
    return ("warn", "Could not check the Proton Drive login",
            "Probably offline. The check runs again in a moment.")


def probe_login(cli):
    if not cli:
        return login_check_result(cli, None, "")
    try:
        r = subprocess.run([cli, "filesystem", "list", "/"],
                           capture_output=True, text=True, timeout=60)
        return login_check_result(cli, r.returncode, r.stdout + r.stderr)
    except (subprocess.TimeoutExpired, OSError):
        return login_check_result(cli, None, "")


def service_check_result(running, autostart):
    """autostart may be None while it is still being determined."""
    if running:
        return ("ok", "Background sync is running", "")
    if autostart:
        return ("fail", "Background sync is not running",
                "It starts again at your next login." if IS_SNAP
                else "It restarts on its own within 2 minutes.")
    if autostart is None:
        return ("fail", "Background sync is not running", "")
    return ("off", "Background sync is off",
            "Turn it on in Settings and press Save.")


def autostart_check_result(enabled):
    if enabled:
        return ("ok", "Starts automatically when you log in", "")
    return ("off", "Does not start automatically",
            "Turn on background sync in Settings and press Save.")


# Known failure classes -> what happened and what to do. Matched against the
# lower-cased reason the daemon stored in queue.tsv; first hit wins.
FAILURE_RULES = (
    (("skip-thumbnails", "thumbnail"),
     "Some images in {name} could not be processed",
     "Proton Drive could not create previews for them. They are retried on "
     "the next sync."),
    (("enoent", "no such file"),
     "{name} changed while it was being uploaded",
     "Nothing to do. It is retried on the next sync."),
    (("eacces", "eperm", "permission denied"),
     "No permission to read {name}",
     "Check the file's permissions. The next sync picks it up."),
    (("enospc", "quota", "storage", "insufficient space", "exceeded"),
     "Not enough space on Proton Drive for {name}",
     "Free up space in Proton Drive or upgrade your plan."),
    (("econn", "etimedout", "enotfound", "eai_again", "network",
      "fetch failed", "socket", "timed out", "timeout"),
     "Connection problem while uploading {name}",
     "Check your internet connection. It is retried on the next sync."),
    (("login", "session", "unauthorized", "401"),
     "Proton Drive session expired while uploading {name}",
     "Log in again: open a terminal and run  {login}"),
)


def describe_failure(name, reason, login_cmd="proton-drive auth login"):
    low = (reason or "").lower()
    for needles, title, advice in FAILURE_RULES:
        if any(n in low for n in needles):
            return (title.format(name=name),
                    advice.format(name=name, login=login_cmd))
    return (f"Could not upload {name}",
            "It is retried on the next sync. If it keeps failing, the "
            "details below and the technical log say why.")


def describe_problems(status, queue, running, poll_minutes, root="",
                      login_cmd="proton-drive auth login"):
    """Things worth the user's attention: (severity, title, advice, details).

    Login/service/autostart are covered by the Checks list and not repeated.
    """
    status = status or {}
    state = status.get("state", "")
    current = str(status.get("current", "") or "")
    out = []
    if root and not os.path.isdir(root):
        out.append(("fail", "The sync folder is missing",
                    "If it is on an external drive, plug it in and the sync "
                    "continues on its own. Otherwise choose another folder "
                    "in Settings.", root))
    elif state == "unconfigured":
        out.append(("fail", "Not set up yet",
                    "Choose a folder to sync in Settings and press Save.", ""))
    elif state == "error" and not current.startswith("Sync folder not found"):
        out.append(("fail", "Proton Drive could not be reached",
                    "Check your internet connection. The sync retries on "
                    "its own.", current))
    if running and state == "polling":
        if IS_SNAP:
            advice = ("Instant change detection is not working; the "
                      "technical log says why.")
        else:
            advice = ("For instant sync install the inotify-tools package "
                      "(sudo apt install inotify-tools). It is picked up "
                      "automatically.")
        out.append(("warn", "Changes are only picked up every "
                    + plural(poll_minutes, "minute"), advice, ""))
    failed = [r for r in queue if r["state"] == "failed"]
    for r in failed[:MAX_PROBLEM_ROWS]:
        title, advice = describe_failure(relative_name(r["path"], root),
                                         r["note"], login_cmd)
        out.append(("fail", title, advice, r["note"]))
    if len(failed) > MAX_PROBLEM_ROWS:
        out.append(("fail", f"{len(failed) - MAX_PROBLEM_ROWS} more could "
                    "not be uploaded", "The full list is in the technical "
                    "log.", ""))
    errors = int(status.get("pass_errors", 0) or 0)
    if errors > len(failed):
        out.append(("warn", plural(errors - len(failed), "other problem")
                    + " in the last sync",
                    "Usually a deleted file that could not be moved to the "
                    "Proton Drive trash. It is retried on the next sync; "
                    "details are in the technical log.", ""))
    return out


def queue_summary(rows, running):
    if not rows:
        return ""
    n = len(rows)
    done = sum(1 for r in rows if r["state"] == "done")
    unchanged = sum(1 for r in rows if r["state"] == "unchanged")
    failed = sum(1 for r in rows if r["state"] == "failed")
    finished = done + unchanged + failed
    if finished < n:
        text = f"{finished} of {n} done"
    else:
        parts = []
        if done:
            parts.append(f"{done} uploaded")
        if unchanged:
            parts.append(f"{unchanged} unchanged")
        text = " · ".join(parts) if parts else f"{n} done"
    if failed:
        text += f" · {failed} failed"
    return text


def pass_summary(status, in_progress=False):
    items = int(status.get("pass_items", 0) or 0)
    nbytes = int(status.get("pass_bytes", 0) or 0)
    if items:
        parts = [plural(items, "file") + (f" · {human_bytes(nbytes)}" if nbytes else "")]
    else:
        parts = ["no new files so far" if in_progress else "nothing new to upload"]
    if status.get("pass_trashed"):
        parts.append(f"{status['pass_trashed']} moved to trash")
    if status.get("pass_errors"):
        parts.append(plural(int(status["pass_errors"]), "problem"))
    if status.get("pass_started"):
        parts.append("started " + fmt_time(status["pass_started"]))
    return " · ".join(parts)


def total_summary(status):
    passes = int(status.get("passes_done", 0) or 0)
    if not passes:
        return "No sync finished yet"
    items = int(status.get("total_items", 0) or 0)
    nbytes = int(status.get("total_bytes", 0) or 0)
    parts = [plural(passes, "sync"),
             plural(items, "file") + (f" · {human_bytes(nbytes)}" if nbytes else "")]
    if status.get("total_trashed"):
        parts.append(f"{status['total_trashed']} moved to trash")
    if status.get("total_errors"):
        parts.append(plural(int(status["total_errors"]), "problem"))
    return " · ".join(parts)


# ----------------------------------------------------------------- chart ---
class PassChart(Gtk.DrawingArea):
    """Bar chart: data uploaded per sync pass (single series, direct label)."""

    def __init__(self):
        super().__init__()
        self.history = []
        self._bars = []  # (x0, x1, record) hit boxes for tooltips
        self.set_size_request(-1, 120)
        self.set_has_tooltip(True)
        self.connect("draw", self.on_draw)
        self.connect("query-tooltip", self.on_tooltip)

    def set_history(self, rows):
        if rows != self.history:
            self.history = rows
            self.queue_draw()

    def on_tooltip(self, _w, x, _y, _kbd, tooltip):
        for x0, x1, rec in self._bars:
            if x0 <= x <= x1:
                err = f", {rec['errors']} problems" if rec.get("errors") else ""
                dur = max(0, rec.get("end", 0) - rec.get("start", 0))
                tooltip.set_text(
                    f"{fmt_time(rec.get('end'))} — {rec.get('items', 0)} files, "
                    f"{human_bytes(rec.get('bytes', 0))}{err}, {dur}s"
                )
                return True
        return False

    def on_draw(self, widget, cr):
        w = widget.get_allocated_width()
        h = widget.get_allocated_height()
        style = widget.get_style_context()
        fg = style.get_color(Gtk.StateFlags.NORMAL)
        pad_top, pad_bottom, pad_x = 18, 20, 6
        base_y = h - pad_bottom
        self._bars = []

        cr.select_font_face("sans")
        cr.set_font_size(11)

        if not self.history:
            cr.set_source_rgba(fg.red, fg.green, fg.blue, 0.55)
            msg = "No finished syncs yet"
            ext = cr.text_extents(msg)
            cr.move_to((w - ext.width) / 2, h / 2)
            cr.show_text(msg)
            return

        # baseline (recessive)
        cr.set_source_rgba(fg.red, fg.green, fg.blue, 0.25)
        cr.set_line_width(1)
        cr.move_to(pad_x, base_y + 0.5)
        cr.line_to(w - pad_x, base_y + 0.5)
        cr.stroke()

        rows = self.history[-CHART_PASSES:]
        n = CHART_PASSES
        gap = 2.0
        slot = (w - 2 * pad_x) / n
        bw = max(2.0, slot - gap)
        max_bytes = max((r.get("bytes", 0) for r in rows), default=0)
        max_h = base_y - pad_top
        # right-align so the newest pass sits at the right edge
        x = w - pad_x - slot * len(rows)

        max_idx = None
        if max_bytes > 0:
            max_idx = max(range(len(rows)), key=lambda i: rows[i].get("bytes", 0))

        for i, rec in enumerate(rows):
            frac = (rec.get("bytes", 0) / max_bytes) if max_bytes else 0
            bh = max(2.0, frac * max_h)  # 2px stub so empty passes stay visible
            bx = x + i * slot + gap / 2
            by = base_y - bh
            r = min(3.0, bw / 2, bh)
            cr.new_sub_path()
            cr.arc(bx + r, by + r, r, 3.14159, 1.5 * 3.14159)
            cr.arc(bx + bw - r, by + r, r, 1.5 * 3.14159, 2 * 3.14159)
            cr.line_to(bx + bw, base_y)
            cr.line_to(bx, base_y)
            cr.close_path()
            cr.set_source_rgb(*BAR_COLOR)
            cr.fill()
            self._bars.append((bx, bx + bw, rec))

            if i == max_idx and rec.get("bytes", 0) > 0:
                label = human_bytes(rec["bytes"])
                ext = cr.text_extents(label)
                lx = min(max(pad_x, bx + bw / 2 - ext.width / 2),
                         w - pad_x - ext.width)
                cr.set_source_rgba(fg.red, fg.green, fg.blue, 0.75)
                cr.move_to(lx, by - 5)
                cr.show_text(label)

        cr.set_source_rgba(fg.red, fg.green, fg.blue, 0.55)
        cr.move_to(pad_x, h - 6)
        cr.show_text("older")
        lbl = "latest"
        ext = cr.text_extents(lbl)
        cr.move_to(w - pad_x - ext.width, h - 6)
        cr.show_text(lbl)


# ------------------------------------------------------------- widgets ---
def small_markup(label, text):
    label.set_markup(f"<small>{esc(text)}</small>")


class Heading(Gtk.Box):
    """Section heading: bold title, optional small subtitle, optional dim
    info text at the right and an optional action button."""

    def __init__(self, title, subtitle=None, info=False, action=None,
                 margin_top=0):
        super().__init__(orientation=Gtk.Orientation.HORIZONTAL, spacing=12,
                         margin_top=margin_top)
        text = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=1,
                       hexpand=True, valign=Gtk.Align.CENTER)
        self.title = Gtk.Label(xalign=0)
        self.title.set_markup(f"<b>{esc(title)}</b>")
        text.pack_start(self.title, False, False, 0)
        self.subtitle = None
        if subtitle is not None:
            self.subtitle = Gtk.Label(xalign=0, ellipsize=Pango.EllipsizeMode.END)
            self.subtitle.get_style_context().add_class("dim-label")
            small_markup(self.subtitle, subtitle)
            text.pack_start(self.subtitle, False, False, 0)
        self.pack_start(text, True, True, 0)
        self.info = None
        if info:
            self.info = Gtk.Label(xalign=1, valign=Gtk.Align.CENTER)
            self.info.get_style_context().add_class("dim-label")
            self.pack_start(self.info, False, False, 0)
        if action is not None:
            action.set_valign(Gtk.Align.CENTER)
            self.pack_end(action, False, False, 0)

    def set_subtitle(self, text):
        if self.subtitle is not None:
            small_markup(self.subtitle, text)

    def set_info(self, text):
        if self.info is not None:
            self.info.set_text(text)


class NoteRow(Gtk.Box):
    """Glyph + title + optional advice + optional one-line details."""

    def __init__(self, selectable=False):
        super().__init__(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        self.glyph = Gtk.Label(xalign=0.5, yalign=0, width_chars=2)
        self.pack_start(self.glyph, False, False, 0)
        text = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        self.title = Gtk.Label(xalign=0, wrap=True, max_width_chars=60)
        self.advice = Gtk.Label(xalign=0, wrap=True, max_width_chars=60,
                                selectable=selectable)
        # Selectable so a command can be copied, but never auto-focused
        # (GTK would select the whole text on first show).
        self.advice.set_can_focus(False)
        self.advice.get_style_context().add_class("dim-label")
        self.advice.set_no_show_all(True)
        self.details = Gtk.Label(xalign=0, ellipsize=Pango.EllipsizeMode.END,
                                 max_width_chars=60)
        self.details.get_style_context().add_class("dim-label")
        self.details.set_no_show_all(True)
        for lbl in (self.title, self.advice, self.details):
            text.pack_start(lbl, False, False, 0)
        self.pack_start(text, True, True, 0)

    def set_content(self, severity, title, advice="", details=""):
        color, glyph = GLYPHS[severity]
        self.glyph.set_markup(
            f'<span foreground="{color}" weight="bold">{glyph}</span>')
        self.title.set_text(title)
        small_markup(self.advice, advice)
        self.advice.set_visible(bool(advice))
        small_markup(self.details, details)
        self.details.set_visible(bool(details))
        self.details.set_tooltip_text(details or None)


# -------------------------------------------------------------------- UI ---
class SettingsWindow(Gtk.ApplicationWindow):
    def __init__(self, app):
        super().__init__(application=app, title="Proton Sync")
        self.set_default_size(640, 760)
        self.cfg = load_config()
        self.cli = find_cli(self.cfg)
        self.sync_proc = None
        self._log_cache = None
        self._queue_cache = None
        self._live_cache = None
        self._problems_cache = None
        self._autostart = None
        self._check_thread = None
        self._toast_timeout = None

        header = Gtk.HeaderBar(show_close_button=True)
        self.set_titlebar(header)
        self.save_btn = Gtk.Button(label="Save")
        self.save_btn.get_style_context().add_class("suggested-action")
        self.save_btn.connect("clicked", self.on_save)
        self.save_btn.set_no_show_all(True)  # only shown on the Settings page
        header.pack_end(self.save_btn)

        self.stack = Gtk.Stack(
            transition_type=Gtk.StackTransitionType.SLIDE_LEFT_RIGHT)
        switcher = Gtk.StackSwitcher(stack=self.stack)
        header.set_custom_title(switcher)

        # Short messages ("Settings saved.") slide in over the page.
        overlay = Gtk.Overlay()
        self.add(overlay)
        overlay.add(self.stack)
        self.toast = Gtk.Revealer(
            transition_type=Gtk.RevealerTransitionType.SLIDE_DOWN,
            halign=Gtk.Align.CENTER, valign=Gtk.Align.START)
        toast_box = Gtk.Box()
        toast_box.get_style_context().add_class("app-notification")
        self.toast_label = Gtk.Label(margin_start=12, margin_end=12,
                                     margin_top=4, margin_bottom=4)
        toast_box.add(self.toast_label)
        self.toast.add(toast_box)
        overlay.add_overlay(self.toast)
        overlay.set_overlay_pass_through(self.toast, True)

        self.stack.add_titled(self._build_settings_page(), "settings",
                              "Settings")
        self.stack.add_titled(self._build_activity_page(), "activity",
                              "Activity")
        self.stack.connect("notify::visible-child-name", self._on_page_changed)
        self.save_btn.show()

        # Gtk.Stack ignores set_visible_child() until its children are shown,
        # so the first refresh runs once the window is mapped.
        self._started = False
        self.connect("map", self._on_map)
        GLib.timeout_add_seconds(10, self.refresh_checks)
        GLib.timeout_add_seconds(2, self.refresh_activity)

    def _on_map(self, *_args):
        if self._started:
            return
        self._started = True
        self._on_files_view_toggled(None)
        self.refresh_checks()
        self.refresh_activity()

    def _on_page_changed(self, *_args):
        self.save_btn.set_visible(
            self.stack.get_visible_child_name() == "settings")

    # ------------------------------------------------------ settings page --
    def _build_settings_page(self):
        outer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=18,
                        margin=18)
        grid = Gtk.Grid(column_spacing=18, row_spacing=14)
        outer.pack_start(grid, False, False, 0)

        self.folder_btn = Gtk.FileChooserButton(
            title="Folder to sync",
            action=Gtk.FileChooserAction.SELECT_FOLDER,
        )
        self.folder_btn.set_hexpand(True)
        self.folder_btn.set_valign(Gtk.Align.CENTER)
        local_root = self.cfg.get("LOCAL_ROOT", "")
        if local_root:
            self.folder_btn.set_filename(local_root)
        self.folder_btn.connect("file-set",
                                lambda *_: self._refresh_exclude_labels())
        self._settings_row(grid, 0, "Folder to sync", None, self.folder_btn)

        self.remote_entry = Gtk.Entry(hexpand=True, valign=Gtk.Align.CENTER)
        self.remote_entry.set_text(self.cfg.get("REMOTE_ROOT", ""))
        self.remote_entry.set_placeholder_text("/my-files/Desktop")
        self._settings_row(grid, 1, "Folder on Proton Drive", None,
                           self.remote_entry)

        interval = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8,
                           valign=Gtk.Align.CENTER)
        adj = Gtk.Adjustment(
            value=poll_minutes_from_config(self.cfg.get("POLL_INTERVAL")),
            lower=1, upper=1440, step_increment=1, page_increment=10)
        self.poll_spin = Gtk.SpinButton(adjustment=adj, numeric=True)
        interval.pack_start(self.poll_spin, False, False, 0)
        interval.pack_start(Gtk.Label(label="minutes"), False, False, 0)
        self._settings_row(
            grid, 2, "Check for changes every",
            "Safety net for when instant change detection is unavailable",
            interval)

        full = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8,
                       valign=Gtk.Align.CENTER)
        adj = Gtk.Adjustment(
            value=hours_from_config(self.cfg.get("FULL_CHECK_INTERVAL")),
            lower=1, upper=720, step_increment=1, page_increment=24)
        self.full_spin = Gtk.SpinButton(adjustment=adj, numeric=True)
        full.pack_start(self.full_spin, False, False, 0)
        full.pack_start(Gtk.Label(label="hours"), False, False, 0)
        self._settings_row(
            grid, 3, "Verify all files every",
            "Syncs normally look only at files that changed; this also "
            "re-checks the rest",
            full)

        self.auto_switch = Gtk.Switch(halign=Gtk.Align.START,
                                      valign=Gtk.Align.CENTER)
        self.auto_switch.set_active(autostart_enabled())
        self._settings_row(
            grid, 4, "Background sync",
            "Starts when you log in and uploads whenever files change",
            self.auto_switch)

        self.del_switch = Gtk.Switch(halign=Gtk.Align.START,
                                     valign=Gtk.Align.CENTER)
        self.del_switch.set_active(
            self.cfg.get("SYNC_DELETES", "false") == "true")
        self._settings_row(
            grid, 5, "Sync deletions",
            "Files you delete here move to the Proton Drive trash, where "
            "they can be restored",
            self.del_switch)

        section = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        outer.pack_start(section, True, True, 0)
        section.pack_start(
            Heading("Excluded folders",
                    subtitle="Subfolders that are never uploaded"),
            False, False, 0)
        scroll = Gtk.ScrolledWindow(min_content_height=120,
                                    shadow_type=Gtk.ShadowType.IN)
        self.excl_list = Gtk.ListBox(selection_mode=Gtk.SelectionMode.SINGLE)
        placeholder = Gtk.Label(label="No folders excluded", margin=12)
        placeholder.get_style_context().add_class("dim-label")
        placeholder.show()
        self.excl_list.set_placeholder(placeholder)
        scroll.add(self.excl_list)
        section.pack_start(scroll, True, True, 0)
        btns = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        add_btn = Gtk.Button(label="Add folder…")
        add_btn.connect("clicked", self.on_add_exclude)
        self.rm_btn = Gtk.Button(label="Remove", sensitive=False)
        self.rm_btn.connect("clicked", self.on_remove_exclude)
        self.excl_list.connect(
            "row-selected",
            lambda _l, row: self.rm_btn.set_sensitive(row is not None))
        btns.pack_start(add_btn, False, False, 0)
        btns.pack_start(self.rm_btn, False, False, 0)
        section.pack_start(btns, False, False, 0)
        for p in load_excludes():
            self._add_exclude_row(p)
        return outer

    @staticmethod
    def _settings_row(grid, row, title, subtitle, widget):
        text = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2,
                       valign=Gtk.Align.CENTER)
        text.pack_start(Gtk.Label(label=title, xalign=0), False, False, 0)
        if subtitle:
            sub = Gtk.Label(xalign=0, wrap=True, max_width_chars=34)
            sub.get_style_context().add_class("dim-label")
            small_markup(sub, subtitle)
            text.pack_start(sub, False, False, 0)
        grid.attach(text, 0, row, 1, 1)
        grid.attach(widget, 1, row, 1, 1)

    # ------------------------------------------------------ activity page --
    def _build_activity_page(self):
        outer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8,
                        margin=18)

        top = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
        state_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2,
                            hexpand=True, valign=Gtk.Align.CENTER)
        self.state_label = Gtk.Label(xalign=0,
                                     ellipsize=Pango.EllipsizeMode.END)
        self.state_label.set_markup("<b>…</b>")
        self.state_detail = Gtk.Label(xalign=0,
                                      ellipsize=Pango.EllipsizeMode.MIDDLE)
        self.state_detail.get_style_context().add_class("dim-label")
        state_box.pack_start(self.state_label, False, False, 0)
        state_box.pack_start(self.state_detail, False, False, 0)
        top.pack_start(state_box, True, True, 0)
        self.sync_btn = Gtk.Button(label="Sync now", valign=Gtk.Align.CENTER)
        self.sync_btn.set_tooltip_text("Upload what changed, right away")
        self.sync_btn.connect("clicked", self.on_sync_now)
        top.pack_end(self.sync_btn, False, False, 0)
        outer.pack_start(top, False, False, 0)

        outer.pack_start(Heading("Checks", margin_top=10), False, False, 0)
        self.check_rows = {}
        for key, waiting in (("login", "Checking the Proton Drive login…"),
                             ("service", "Checking background sync…"),
                             ("autostart", "Checking autostart…")):
            row = NoteRow(selectable=(key == "login"))
            row.set_content("pending", waiting)
            self.check_rows[key] = row
            outer.pack_start(row, False, False, 0)

        outer.pack_start(Heading("Needs attention", margin_top=10),
                         False, False, 0)
        self.problem_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL,
                                   spacing=8)
        outer.pack_start(self.problem_box, False, False, 0)

        switch = Gtk.Box()
        switch.get_style_context().add_class("linked")
        self.queue_btn = Gtk.RadioButton.new_with_label(None, "Queue")
        self.queue_btn.set_mode(False)
        self.live_btn = Gtk.RadioButton.new_with_label_from_widget(
            self.queue_btn, "Live")
        self.live_btn.set_mode(False)
        self.live_btn.set_tooltip_text(
            "Every file as it is added, updated or moved to the trash")
        switch.pack_start(self.queue_btn, False, False, 0)
        switch.pack_start(self.live_btn, False, False, 0)
        self.files_heading = Heading("Files", subtitle="", info=True,
                                     action=switch, margin_top=10)
        outer.pack_start(self.files_heading, False, False, 0)
        self.queue_store = Gtk.ListStore(str, str, str)  # glyph, name, tooltip
        self.queue_view = Gtk.TreeView(model=self.queue_store,
                                       headers_visible=False)
        self.queue_view.set_tooltip_column(2)
        self.queue_view.get_selection().set_mode(Gtk.SelectionMode.NONE)
        col = Gtk.TreeViewColumn("", Gtk.CellRendererText(xalign=0.5),
                                 markup=0)
        self.queue_view.append_column(col)
        name_cell = Gtk.CellRendererText(ellipsize=Pango.EllipsizeMode.MIDDLE)
        col = Gtk.TreeViewColumn("", name_cell, text=1)
        col.set_expand(True)
        self.queue_view.append_column(col)
        qscroll = Gtk.ScrolledWindow(min_content_height=150,
                                     shadow_type=Gtk.ShadowType.IN)
        qscroll.add(self.queue_view)
        self.files_stack = self._list_or_empty(qscroll, "Nothing synced yet")

        # live feed: newest first
        self.live_store = Gtk.ListStore(str, str, str, str)
        # time, glyph markup, text + dim detail markup, tooltip
        self.live_view = Gtk.TreeView(model=self.live_store,
                                      headers_visible=False)
        self.live_view.set_tooltip_column(3)
        self.live_view.get_selection().set_mode(Gtk.SelectionMode.NONE)
        time_cell = Gtk.CellRendererText(xalign=1)
        time_cell.set_property("foreground", "#868e96")
        self.live_view.append_column(Gtk.TreeViewColumn("", time_cell, text=0))
        self.live_view.append_column(
            Gtk.TreeViewColumn("", Gtk.CellRendererText(xalign=0.5), markup=1))
        text_cell = Gtk.CellRendererText(ellipsize=Pango.EllipsizeMode.END)
        col = Gtk.TreeViewColumn("", text_cell, markup=2)
        col.set_expand(True)
        self.live_view.append_column(col)
